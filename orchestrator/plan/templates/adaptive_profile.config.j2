// adaptive_profile.config
// Generated by ftd-orchestrator
// Date:             {{ generated_at }}
// Host:             {{ hostname }}
// GPU:              {{ gpu_info }}
// RAM available:    {{ ram_available_gb | round(1) }}GB
// CPU threads:      {{ cpu_threads }}
// Parameter source: {{ source }}
//
// Do NOT edit manually.
// Regenerate with: ftd-orchestrator run --repo-root <path>

profiles {
    adaptive_profile {

        // ── Segmenter ─────────────────────────────────────────────────
        params.brain_segmenter   = "{{ brain_segmenter }}"
        {% if fastsurfer_device %}
        params.fastsurfer_device  = "{{ fastsurfer_device }}"
        params.fastsurfer_threads = {{ fastsurfer_threads }}
        {% endif %}

        // ── Parallelism ───────────────────────────────────────────────
        params.maxforks         = {{ maxforks_segmenter }}
        params.pyradiomics_jobs = {{ pyradiomics_jobs }}
    }
}